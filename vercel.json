{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm install --prefix web --include=dev && npm run build --prefix web",
  "outputDirectory": "web/.next",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/pyapi/:path*",
      "destination": "/api/index.py"
    }
  ]
}
